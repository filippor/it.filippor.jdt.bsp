<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>it.filippor.jdt</groupId>
  <artifactId>it.filippor.jdt.bsp.parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>it.filippor.jdt.bsp.target</module>
    <module>it.filippor.jdt.bsp.core</module>
    <module>it.filippor.jdt.bsp.ui</module>
    <module>it.filippor.jdt.bsp.feature</module>
    <module>it.filippor.jdt.bsp.repository</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tycho.version>4.0.12</tycho.version>
    <maven.dependency.plugin.version>3.8.1</maven.dependency.plugin.version>
    <eclipse-p2-repo.url>https://download.eclipse.org/releases/2025-03</eclipse-p2-repo.url>
  </properties>

  <pluginRepositories>
    <pluginRepository>
      <id>eclipse-hosted</id>
      <url>https://repo.eclipse.org/content/repositories/eclipse/</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven.dependency.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <target>
            <artifact>
              <groupId>${project.groupId}</groupId>
              <artifactId>it.filippor.jdt.bsp.target</artifactId>
              <version>${project.version}</version>
              <classifier>it.filippor.jdt.bsp-2025-03</classifier>
            </artifact>
          </target>
          <dependency-resolution>
            <pomDependencies>consider</pomDependencies>
          </dependency-resolution>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
