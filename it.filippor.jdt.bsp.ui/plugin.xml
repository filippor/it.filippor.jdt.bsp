<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="it.filippor.jdt.bsp.ui.BspEarlyStartup">
      </startup>
   </extension>

   <extension
         point="org.eclipse.ui.commands">
      <category
            id="it.filippor.jdt.bsp.ui.commands.category"
            name="JDT BSP">
      </category>
      <command
            categoryId="it.filippor.jdt.bsp.ui.commands.category"
            id="it.filippor.jdt.bsp.ui.commands.start"
            name="JDT BSP: Start Client">
      </command>
      <command
            categoryId="it.filippor.jdt.bsp.ui.commands.category"
            id="it.filippor.jdt.bsp.ui.commands.stop"
            name="JDT BSP: Stop Client">
      </command>
      <command
            categoryId="it.filippor.jdt.bsp.ui.commands.category"
            id="it.filippor.jdt.bsp.ui.commands.restartRoot"
            name="JDT BSP: Restart Root and Reload Projects">
      </command>
      <command
            categoryId="it.filippor.jdt.bsp.ui.commands.category"
            id="it.filippor.jdt.bsp.ui.commands.showActionableTasks"
            name="JDT BSP: Show Actionable Tasks">
      </command>
   </extension>

   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="it.filippor.jdt.bsp.ui.ui.StartBspClientHandler"
            commandId="it.filippor.jdt.bsp.ui.commands.start">
      </handler>
      <handler
            class="it.filippor.jdt.bsp.ui.ui.StopBspClientHandler"
            commandId="it.filippor.jdt.bsp.ui.commands.stop">
      </handler>
      <handler
            class="it.filippor.jdt.bsp.ui.ui.RestartBspRootProjectHandler"
            commandId="it.filippor.jdt.bsp.ui.commands.restartRoot">
      </handler>
      <handler
            class="it.filippor.jdt.bsp.ui.ui.view.ShowBspActionableTasksViewHandler"
            commandId="it.filippor.jdt.bsp.ui.commands.showActionableTasks">
      </handler>
   </extension>

   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="it.filippor.jdt.bsp.ui.menu"
               label="BSP">
            <command
                  commandId="it.filippor.jdt.bsp.ui.commands.start"
                  label="Start BSP Client"
                  style="push">
            </command>
            <command
                  commandId="it.filippor.jdt.bsp.ui.commands.stop"
                  label="Stop BSP Client"
                  style="push">
            </command>
            <command
                  commandId="it.filippor.jdt.bsp.ui.commands.showActionableTasks"
                  label="Show BSP Actionable Tasks"
                  style="push">
            </command>
         </menu>
      </menuContribution>
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="it.filippor.jdt.bsp.ui.commands.restartRoot"
               label="Restart BSP Server and Reload Projects"
               style="push">
            <visibleWhen>
               <with variable="selection">
                  <count value="1"></count>
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IProject">
                        <test
                              property="org.eclipse.core.resources.projectNature"
                              value="it.filippor.jdt.bsp.core.bspRootNature">
                        </test>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>

   <extension
         point="org.eclipse.ui.views">
      <category
            id="it.filippor.jdt.bsp.ui.views.category"
            name="JDT BSP">
      </category>
      <view
            category="it.filippor.jdt.bsp.ui.views.category"
            class="it.filippor.jdt.bsp.ui.ui.view.BspActionableTasksView"
            id="it.filippor.jdt.bsp.ui.views.actionableTasks"
            name="BSP Actionable Tasks"
            restorable="true">
      </view>
   </extension>

   <extension
         point="org.eclipse.ui.importWizards">
      <wizard
            category="org.eclipse.ui.Basic"
            class="it.filippor.jdt.bsp.ui.ui.wizard.GradleBspImportWizard"
            id="it.filippor.jdt.bsp.ui.wizard.import.gradleBsp"
            name="BSP Import">
      </wizard>
   </extension>

<extension point="org.eclipse.ui.propertyPages">
   <page
         class="it.filippor.jdt.bsp.ui.ui.property.BspRootProjectPropertyPage"
         id="it.filippor.jdt.bsp.ui.propertyPage.bspRoot"
         name="BSP Root">
      <enabledWhen>
         <adapt type="org.eclipse.core.resources.IProject">
            <test
                  property="org.eclipse.core.resources.projectNature"
                  value="it.filippor.jdt.bsp.core.bspRootNature">
            </test>
         </adapt>
      </enabledWhen>
   </page>
</extension>



   <extension
         point="org.eclipse.ui.decorators">
      <decorator
            class="it.filippor.jdt.bsp.ui.ui.decorators.BspProjectLabelDecorator"
            id="it.filippor.jdt.bsp.ui.decorators.projectLabel"
            label="BSP Project Folder Decorator"
            lightweight="false"
            state="true">
         <enablement>
            <or>
               <objectClass
                     name="org.eclipse.core.resources.IProject">
               </objectClass>
               <objectClass
                     name="org.eclipse.jdt.core.IJavaProject">
               </objectClass>
               <objectClass
                     name="org.eclipse.jdt.core.IClasspathEntry">
               </objectClass>
               <objectClass
                     name="org.eclipse.core.runtime.IAdaptable">
               </objectClass>
               <objectClass
                     name="org.eclipse.jdt.internal.ui.packageview.ClassPathContainer$RequiredProjectWrapper">
               </objectClass>
            </or>
         </enablement>
      </decorator>
   </extension>

   <extension
         point="org.eclipse.ui.navigator.navigatorContent">
      <navigatorContent
            activeByDefault="true"
            contentProvider="it.filippor.jdt.bsp.ui.ui.decorators.BspSourceSetContentProvider"
            id="it.filippor.jdt.bsp.ui.navigator.buildTargets"
            labelProvider="it.filippor.jdt.bsp.ui.ui.decorators.BspSourceSetLabelProvider"
            name="BSP Build Targets"
            priority="normal">
         <triggerPoints>
            <instanceof
                  value="org.eclipse.core.resources.IProject">
            </instanceof>
         </triggerPoints>
         <possibleChildren>
            <instanceof
                  value="org.eclipse.core.resources.IProject">
            </instanceof>
         </possibleChildren>
      </navigatorContent>
   </extension>

   <extension
         point="org.eclipse.ui.navigator.viewer">
      <viewerContentBinding
            viewerId="org.eclipse.ui.navigator.ProjectExplorer">
         <includes>
            <contentExtension
                  pattern="it.filippor.jdt.bsp.ui.navigator.buildTargets">
            </contentExtension>
         </includes>
      </viewerContentBinding>
   </extension>

   <extension
         point="it.filippor.jdt.bsp.core.classpathEnricher">
      <enricher
            class="it.filippor.jdt.bsp.ui.classpath.GradleApiFallbackClasspathEnricher"
            order="100">
      </enricher>
   </extension>

</plugin>