<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>

   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="it.filippor.jdt.bsp.core.BspPreferenceInitializer">
      </initializer>
   </extension>

   <extension-point
         id="classpathEnricher"
         name="BSP Classpath Enricher"
         schema="schema/classpathEnricher.exsd">
   </extension-point>

   <extension
         id="bspRootNature"
         name="JDT BSP Root Project"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run
               class="it.filippor.jdt.bsp.core.nature.BspRootProjectNature">
         </run>
      </runtime>
   </extension>

   <extension
         id="bspContainerNature"
         name="JDT BSP Container Project"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run
               class="it.filippor.jdt.bsp.core.nature.BspModuleProjectNature">
         </run>
      </runtime>
   </extension>

   <extension
         id="bspBuildTargetNature"
         name="JDT BSP Build Target Project"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run
               class="it.filippor.jdt.bsp.core.nature.BspSourceSetProjectNature">
         </run>
      </runtime>
   </extension>

</plugin>