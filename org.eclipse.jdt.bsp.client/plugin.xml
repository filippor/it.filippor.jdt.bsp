<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="org.eclipse.jdt.bsp.client.BspPreferenceInitializer">
      </initializer>
   </extension>

   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="org.eclipse.jdt.bsp.client.BspEarlyStartup">
      </startup>
   </extension>

   <extension
         point="org.eclipse.ui.commands">
      <category
            id="org.eclipse.jdt.bsp.client.commands.category"
            name="JDT BSP">
      </category>
      <command
            categoryId="org.eclipse.jdt.bsp.client.commands.category"
            id="org.eclipse.jdt.bsp.client.commands.start"
            name="JDT BSP: Start Client">
      </command>
      <command
            categoryId="org.eclipse.jdt.bsp.client.commands.category"
            id="org.eclipse.jdt.bsp.client.commands.stop"
            name="JDT BSP: Stop Client">
      </command>
   </extension>

   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="org.eclipse.jdt.bsp.client.ui.StartBspClientHandler"
            commandId="org.eclipse.jdt.bsp.client.commands.start">
      </handler>
      <handler
            class="org.eclipse.jdt.bsp.client.ui.StopBspClientHandler"
            commandId="org.eclipse.jdt.bsp.client.commands.stop">
      </handler>
   </extension>

   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="org.eclipse.jdt.bsp.client.menu"
               label="BSP">
            <command
                  commandId="org.eclipse.jdt.bsp.client.commands.start"
                  label="Start BSP Client"
                  style="push">
            </command>
            <command
                  commandId="org.eclipse.jdt.bsp.client.commands.stop"
                  label="Stop BSP Client"
                  style="push">
            </command>
         </menu>
      </menuContribution>
   </extension>

   <extension
         point="org.eclipse.ui.importWizards">
      <wizard
            category="org.eclipse.ui.Basic"
            class="org.eclipse.jdt.bsp.client.ui.GradleBspImportWizard"
            id="org.eclipse.jdt.bsp.client.wizard.import.gradleBsp"
            name="BSP Import">
      </wizard>
   </extension>

   <extension
         point="org.eclipse.ui.propertyPages">
      <page
            class="org.eclipse.jdt.bsp.client.ui.BspRootProjectPropertyPage"
            id="org.eclipse.jdt.bsp.client.propertyPage.bspRoot"
            name="BSP Root"
            objectClass="org.eclipse.core.resources.IProject">
         <enabledWhen>
            <adapt type="org.eclipse.core.resources.IProject">
               <test
                     property="org.eclipse.core.resources.projectNature"
                     value="org.eclipse.jdt.bsp.core.bspRootNature">
               </test>
            </adapt>
         </enabledWhen>
      </page>
   </extension>

</plugin>